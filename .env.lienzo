# Variables para el build de Lienzo (`vite build --mode lienzo`).
# NO contiene secretos: solo la URL PÚBLICA del backend en remo, al que el
# sitio estático de Lienzo llamará para ejecutar Claude (bajo control de Joaquín).
# El token de la suscripción NUNCA sale del servidor remo.
VITE_API_BASE=https://remo.upaep.mx/conoce-claude/api
