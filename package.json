{
  "name": "tutorial-claude",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tutorial interactivo para conocer las capacidades de Claude Opus 4.8",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && rm -rf /var/www/html/conoce-claude/assets && cp -r dist/. /var/www/html/conoce-claude/",
    "build:lienzo": "tsc -b && vite build --mode lienzo",
    "zip:lienzo": "npm run build:lienzo && rm -f conoce-claude-lienzo.zip && cd dist && zip -r -X ../conoce-claude-lienzo.zip . -x '.*' '*/.*'",
    "server": "tsx server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.2.8",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "katex": "^0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
